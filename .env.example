# Copy to .env (local) or set as Vercel env vars on the ninaivu-api project. Never commit real values.

# FalkorDB (Docker defaults below; FalkorDB Cloud gives host/port/username/password)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_SSL=false

# Claude
ANTHROPIC_API_KEY=
NINAIVU_MODEL=claude-haiku-5-5
# Paid agent turns allowed per UTC day across the whole demo (chat + end session); 0 = no cap
DEMO_DAILY_TURNS=150
# Local cost ledger (JSONL, relative to the repo root). Leave empty on Vercel. Report: python -m scripts.usage_report
USAGE_LEDGER=usage.jsonl

# Embeddings (Voyage AI)
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4-lite
EMBED_DIM=1024
# 1 = deterministic hash vectors, no Voyage calls (seeding/load tests without a key; recall quality is meaningless)
EMBEDDINGS_FAKE=0
